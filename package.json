{
  "name": "taxsorted",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "engine",
    "frontend",
    "api",
    "desktop"
  ],
  "overrides": {
    "hono": "4.13.7",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:infrastructure": "node --test scripts/release/frontend-contract.test.mjs infrastructure/testing/__tests__/*.test.mjs",
    "check:release-pages": "node scripts/release/frontend-contract.mjs check-build",
    "infrastructure:restore": "node infrastructure/testing/database-recovery.mjs --allow-local-container",
    "build": "npm run build --workspace frontend",
    "desktop:build": "npm run build && npm run stage --workspace @taxsorted/desktop",
    "desktop:install-runtime": "npm run install-runtime --workspace @taxsorted/desktop",
    "desktop:start": "npm run start --workspace @taxsorted/desktop --",
    "desktop:package": "npm run package --workspace @taxsorted/desktop --",
    "desktop:test": "npm run test --workspace @taxsorted/desktop",
    "desktop:doctor": "node desktop/testing/doctor.cjs",
    "desktop:smoke": "node desktop/testing/runtime-smoke.cjs",
    "desktop:inspect": "node desktop/testing/inspect-package.cjs",
    "desktop:checksums": "node desktop/testing/checksums.cjs",
    "scaffold:local": "node scripts/create-local-project.mjs",
    "validate:uk-personal-tax": "node scripts/validate-uk-personal-tax.mjs",
    "validate:uk-politics": "node scripts/validate-uk-politics.mjs && npm run validate:public-decision-pathways --workspace api",
    "validate:uk-tax-system": "npm run validate:tax-system --workspace api",
    "validate:uk-tax-identity": "npm run validate:tax-identity --workspace api",
    "validate:uk-tax-industry": "npm run validate:tax-industry --workspace api",
    "validate:uk-charities": "npm run validate:charities --workspace api",
    "validate:uk-observer-accountability": "npm run validate:observer-accountability-candidate --workspace api",
    "validate:uk-public-funding": "npm run validate:public-funding --workspace api",
    "validate:professional-opportunity-assessment": "npm run validate:professional-opportunity-assessment --workspace api --",
    "review:professional-opportunities": "npm run review:professional-opportunities --workspace api --",
    "validate:professional-opportunity-review": "npm run check:professional-opportunity-review --workspace api",
    "validate:learn": "npm run validate:uk-personal-tax && npm run validate:uk-politics && npm run validate:uk-tax-system && npm run validate:uk-tax-identity && npm run validate:uk-tax-industry && npm run validate:uk-charities && npm run validate:uk-observer-accountability && npm run validate:uk-public-funding && npm run validate:professional-opportunity-review",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:infrastructure",
    "typecheck:infrastructure": "tsc --project infrastructure/testing/tsconfig.json"
  }
}
